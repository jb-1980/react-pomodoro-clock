{
  "name": "react-pomodoro-clock",
  "private": true,
  "version": "2.0.0",
  "description": "A simple pomodoro timer built with React and TypeScript.",
  "keywords": [
    "pomodoro",
    "timer",
    "react",
    "typescript"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/jb-1980/react-pomodoro-clock.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . && prettier --check \"**/*.{ts,js,mjs,cjs,jsx,tsx,json,css,scss,html,md,yaml,yml}\"",
    "preview": "vite preview",
    "test:browser": "vitest --config=vitest.browser.config.ts"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.11",
    "vitest-browser-react": "^2.2.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "prettier": {
    "semi": false,
    "singleQuote": false,
    "printWidth": 80,
    "tabWidth": 2,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "bracketSameLine": false
  }
}
